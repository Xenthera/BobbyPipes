      "apply": {
        "model": "bobbypipes:block/pipe_cap"
      }
    },
    {
      "when": {
        "east": "none"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_cap",
        "y": 90
      }
    },
    {
      "when": {
        "south": "none"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_cap",
        "y": 180
      }
    },
    {
      "when": {
        "west": "none"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_cap",
        "y": 270
      }
    },
    {
      "when": {
        "up": "none"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_cap",
        "x": 270
      }
    },
    {
      "when": {
        "down": "none"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_cap",
        "x": 90
      }
    }
  ]
