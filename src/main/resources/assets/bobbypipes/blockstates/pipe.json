{
  "multipart": [
    {
      "when": {
        "north": "inventory|direct|indirect"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_arm"
      }
    },
    {
      "when": {
        "east": "inventory|direct|indirect"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_arm",
        "y": 90
      }
    },
    {
      "when": {
        "south": "inventory|direct|indirect"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_arm",
        "y": 180
      }
    },
    {
      "when": {
        "west": "inventory|direct|indirect"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_arm",
        "y": 270
      }
    },
    {
      "when": {
        "up": "inventory|direct|indirect"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_arm",
        "x": 270
      }
    },
    {
      "when": {
        "down": "inventory|direct|indirect"
      },
      "apply": {
        "model": "bobbypipes:block/pipe_arm",
        "x": 90
      }
    },
    {
      "when": {
